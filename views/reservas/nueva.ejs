<a class="volver" href="/reservas">← Volver al listado</a>
<section class="formulario-caja"><span class="etiqueta"><%= seccion %></span><h1>Nueva reserva</h1><p>Completá los datos para solicitar un turno de estudio.</p>
<% if (error) { %><div class="alerta" role="alert"><%= error %></div><% } %>
<form action="/reservas" method="post" novalidate>
  <div class="campo"><label for="estudiante">Nombre del estudiante</label><input id="estudiante" name="estudiante" type="text" required value="<%= valores.estudiante || '' %>" placeholder="Ej.: Ana Pérez"></div>
  <div class="campo"><label for="email">Correo electrónico</label><input id="email" name="email" type="email" required value="<%= valores.email || '' %>" placeholder="Ej.: ana@correo.com"></div>
  <div class="campo"><label for="sala">Sala</label><select id="sala" name="sala" required><option value="">Elegí una sala</option><% salasPermitidas.forEach(sala => { %><option value="<%= sala %>" <%= valores.sala === sala ? 'selected' : '' %>><%= sala %></option><% }) %></select></div>
  <div class="campo"><label for="fecha">Fecha</label><input id="fecha" name="fecha" type="date" required value="<%= valores.fecha || '' %>"></div>
  <div class="campo"><label for="turno">Turno</label><select id="turno" name="turno" required><option value="">Elegí un turno</option><% turnosPermitidos.forEach(turno => { %><option value="<%= turno %>" <%= valores.turno === turno ? 'selected' : '' %>><%= turno %></option><% }) %></select></div>
  <div class="campo"><label for="personas">Cantidad de personas (1 a 6)</label><input id="personas" name="personas" type="number" min="1" max="6" step="1" required value="<%= valores.personas || '' %>"></div>
  <button class="boton" type="submit">Confirmar reserva</button>
</form></section>
